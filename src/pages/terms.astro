---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/site/Navigation.astro';
import Footer from '../components/site/Footer.astro';
import SectionEyebrow from '../components/ui/astro/SectionEyebrow.astro';
---

<Layout title="Bodega - Terms of Service">
  <div class="min-h-screen bg-zinc-950 flex flex-col relative overflow-hidden">
    <Navigation />
    
    <main class="relative z-10 flex-1 max-w-[1600px] w-full mx-auto px-6 sm:px-10 lg:px-16 py-16 lg:py-24 border-b border-white/5">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sticky Left Navigation -->
        <aside class="lg:col-span-3 lg:sticky lg:top-24 space-y-4 font-mono text-xs text-zinc-500">
          <div class="text-[9px] uppercase tracking-widest text-zinc-500 mb-4 border-b border-white/10 pb-2">// TERMS_INDEX</div>
          <ul class="space-y-3">
            <li><a href="#sec-1" class="hover:text-indigo-400 block transition-colors">1.0_TERMINAL_ACCESS</a></li>
            <li><a href="#sec-2" class="hover:text-indigo-400 block transition-colors">2.0_SERVICE_RELIABILITY</a></li>
            <li><a href="#sec-3" class="hover:text-indigo-400 block transition-colors">3.0_COMPUTE_LIABILITY</a></li>
          </ul>
        </aside>

        <!-- Right Column Legal Copy -->
        <div class="lg:col-span-9 space-y-16">
          
          <div class="border-l-2 border-indigo-500 pl-6">
            <SectionEyebrow class="mb-2">Operator Service Guidelines</SectionEyebrow>
            <h1 class="text-3xl font-light text-white uppercase tracking-tight">Terms of Service</h1>
            <p class="mt-2 text-zinc-500 font-mono text-xs">// STATUS: ACTIVE_CONTRACT // EFFECTIVE: 2026-05-20</p>
          </div>

          <!-- Section 1 -->
          <section id="sec-1" class="space-y-4 scroll-mt-24">
            <h2 class="text-lg font-bold font-mono text-white uppercase">1.0 Terminal Access & Boundaries</h2>
            <p class="text-sm text-zinc-400 font-sans leading-relaxed">
              By establishing an active secure uplink tunnel to Bodega services, you agree to comply with our localized security policies. 
              Operators are fully responsible for preserving their client authorization keys and node configuration files.
            </p>
            <p class="text-sm text-zinc-400 font-sans leading-relaxed">
              Any attempt to bypass access matrix limits, trigger unauthorized telemetry overflows, or inject malformed cryptographic signatures will result in immediate termination of the node bridge.
            </p>
          </section>

          <!-- Section 2 -->
          <section id="sec-2" class="space-y-4 border-t border-white/5 pt-12 scroll-mt-24">
            <h2 class="text-lg font-bold font-mono text-white uppercase">2.0 Service Reliability & Sandboxes</h2>
            <p class="text-sm text-zinc-400 font-sans leading-relaxed">
              Our sandbox nodes are provided "as-is" during experimental testing phases. 
              We reserve the right to deploy patches, adjust latency constraints, or reset test environments as needed to optimize ledger capabilities.
            </p>
            <p class="text-sm text-zinc-400 font-sans leading-relaxed">
              While we guarantee high-fidelity data continuity, localized server breakdowns or internet routing latency may affect real-time scale feeds. Operators are encouraged to configure localized backups.
            </p>
          </section>

          <!-- Section 3 -->
          <section id="sec-3" class="space-y-4 border-t border-white/5 pt-12 scroll-mt-24">
            <h2 class="text-lg font-bold font-mono text-white uppercase">3.0 Compute Liability Limitations</h2>
            <p class="text-sm text-zinc-400 font-sans leading-relaxed">
              Bodega operates purely as a coordination command layer. We assume no liability for material stock discrepancies, physical facility disruptions, or logistics operational delays occurring at node locations.
            </p>
            <p class="text-sm text-zinc-400 font-sans leading-relaxed">
              By using our platform, the operator acknowledges that the digital ledger reflects transaction records committed through active client keys, and physical-digital parity remains under operator control.
            </p>
          </section>

        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
