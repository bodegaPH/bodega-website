---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/site/Navigation.astro';
import Footer from '../components/site/Footer.astro';
import SectionEyebrow from '../components/ui/astro/SectionEyebrow.astro';
import OpBadge from '../components/ui/astro/OpBadge.astro';
---

<Layout title="Bodega - Documentation Portal">
  <div class="min-h-screen bg-zinc-950 flex flex-col relative">
    <Navigation />
    
    <main class="relative z-10 flex-1 max-w-[1600px] w-full mx-auto px-6 sm:px-10 lg:px-16 py-16 lg:py-24 border-b border-white/5">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Sticky Left Sidebar: Docs Navigation -->
        <aside class="lg:col-span-3 lg:sticky lg:top-24 space-y-8 font-mono text-xs">
          <div>
            <div class="text-[9px] uppercase tracking-widest text-zinc-500 mb-4 border-b border-white/10 pb-2">
              // ARCHITECTURE_MANUAL
            </div>
            <ul class="space-y-3">
              <li>
                <a
                  href="#getting-started"
                  data-nav-link="getting-started"
                  class="nav-link block py-1 pl-3 border-l border-transparent text-zinc-400 transition-all duration-200 hover:text-indigo-400"
                >
                  01_GETTING_STARTED
                </a>
              </li>
              <li>
                <a
                  href="#operation-vectors"
                  data-nav-link="operation-vectors"
                  class="nav-link block py-1 pl-3 border-l border-transparent text-zinc-400 transition-all duration-200 hover:text-indigo-400"
                >
                  02_OPERATION_VECTORS
                </a>
              </li>
              <li>
                <a
                  href="#ledger-integrity"
                  data-nav-link="ledger-integrity"
                  class="nav-link block py-1 pl-3 border-l border-transparent text-zinc-400 transition-all duration-200 hover:text-indigo-400"
                >
                  03_LEDGER_IMMUTABILITY
                </a>
              </li>
            </ul>
          </div>

          <div>
            <div class="text-[9px] uppercase tracking-widest text-zinc-500 mb-4 border-b border-white/10 pb-2">
              // INTEGRATION_UPLINKS
            </div>
            <ul class="space-y-3">
              <li>
                <a href="/docs/api" class="text-zinc-400 block py-1 hover:text-indigo-400 transition-colors flex items-center justify-between">
                  <span>API_REFERENCE</span>
                  <span class="text-[8px] bg-indigo-500/10 text-indigo-400 px-1 border border-indigo-500/20">V1</span>
                </a>
              </li>
            </ul>
          </div>
        </aside>

        <!-- Right Column: Document Content -->
        <div class="lg:col-span-9 space-y-24">
          
          <!-- Page Header -->
          <div class="border-l-2 border-indigo-500 pl-6">
            <SectionEyebrow class="mb-2">Architecture Manual</SectionEyebrow>
            <h1 class="text-3xl sm:text-4xl font-light text-white uppercase tracking-tight">Documentation</h1>
            <p class="mt-4 text-zinc-400 text-base font-sans max-w-2xl leading-relaxed">
              Learn how to set up, run, and scale Bodega in your warehouses to achieve real-time physical-digital parity.
            </p>
          </div>

          <!-- Section 1: Getting Started -->
          <section id="getting-started" class="space-y-8 scroll-mt-24">
            <div class="border-l-2 border-indigo-500 pl-6">
              <SectionEyebrow class="mb-2">Manual Section 01</SectionEyebrow>
              <h2 class="text-3xl font-light text-white uppercase tracking-tight">Getting Started</h2>
            </div>
            
            <p class="text-base text-zinc-400 leading-relaxed font-sans">
              Bodega is designed as a static, light-footprint infrastructure command deck. 
              To launch an isolated workspace locally and initialize telemetry streams, execute the following setup sequence:
            </p>

            <div class="space-y-4">
              <div class="bg-zinc-900/40 border border-white/5 p-5 relative">
                <span class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/20"></span>
                <span class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/20"></span>
                <span class="text-[9px] font-mono text-zinc-500 tracking-widest block mb-3 uppercase">// TERMINAL // CLONE_SETUP</span>
                <pre class="font-mono text-xs text-indigo-400 overflow-x-auto"><code>git clone https://github.com/BodegaPH/bodega-app.git
cd bodega-app
pnpm install</code></pre>
              </div>

              <div class="bg-zinc-900/40 border border-white/5 p-5 relative">
                <span class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/20"></span>
                <span class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/20"></span>
                <span class="text-[9px] font-mono text-zinc-500 tracking-widest block mb-3 uppercase">// TERMINAL // SPIN_DEV_NODE</span>
                <pre class="font-mono text-xs text-indigo-400 overflow-x-auto"><code># Start isolated edge telemetry server
pnpm dev</code></pre>
              </div>
            </div>

            <p class="text-sm font-sans text-zinc-500">
              The local setup launches a private testing dashboard listening at <code class="text-white bg-white/5 px-2 py-0.5 border border-white/10 font-mono text-xs">localhost:4321</code>. 
              Use this dashboard to safely test stock movements and configure scanning rules before going live across all warehouse locations.
            </p>
          </section>

          <!-- Section 2: Operation Vectors -->
          <section id="operation-vectors" class="space-y-8 border-t border-white/5 pt-16 scroll-mt-24">
            <div class="border-l-2 border-indigo-500 pl-6">
              <SectionEyebrow class="mb-2">Manual Section 02</SectionEyebrow>
              <h2 class="text-3xl font-light text-white uppercase tracking-tight">Operation Vectors</h2>
            </div>
            
            <p class="text-base text-zinc-400 leading-relaxed font-sans">
              Instead of allowing anyone to edit database rows directly (which leads to mistakes and lost stock), Bodega limits inventory actions to three real-world events. Every single event is permanently logged:
            </p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
              
              <!-- Vector: RECEIVE -->
              <div class="border border-white/5 bg-zinc-900/20 p-6 relative">
                <span class="absolute top-0 left-0 w-1.5 h-1.5 border-t border-l border-white/20"></span>
                <div class="flex items-center gap-2 mb-4">
                  <OpBadge class="bg-indigo-500/10 text-indigo-400">OP:RECEIVE</OpBadge>
                </div>
                <h3 class="text-base font-bold text-white uppercase mb-2 font-mono">01_RECEIVE_STOCK</h3>
                <p class="text-xs text-zinc-500 leading-relaxed font-sans">
                  Receiving new stock. Adds verified quantities directly to a specific warehouse bin.
                </p>
              </div>

              <!-- Vector: ADJUST -->
              <div class="border border-white/5 bg-zinc-900/20 p-6 relative">
                <span class="absolute top-0 left-0 w-1.5 h-1.5 border-t border-l border-white/20"></span>
                <div class="flex items-center gap-2 mb-4">
                  <OpBadge class="bg-indigo-500/10 text-indigo-400">OP:ADJUST</OpBadge>
                </div>
                <h3 class="text-base font-bold text-white uppercase mb-2 font-mono">02_ADJUST_STOCK</h3>
                <p class="text-xs text-zinc-500 leading-relaxed font-sans">
                  Reconciling stock. Adjusts inventory counts after physical audits with mandatory manager signatures.
                </p>
              </div>

              <!-- Vector: ISSUE -->
              <div class="border border-white/5 bg-zinc-900/20 p-6 relative">
                <span class="absolute top-0 left-0 w-1.5 h-1.5 border-t border-l border-white/20"></span>
                <div class="flex items-center gap-2 mb-4">
                  <OpBadge class="bg-indigo-500/10 text-indigo-400">OP:ISSUE</OpBadge>
                </div>
                <h3 class="text-base font-bold text-white uppercase mb-2 font-mono">03_ISSUE_STOCK</h3>
                <p class="text-xs text-zinc-500 leading-relaxed font-sans">
                  Deploying assets. Safely subtracts stock to fulfill orders, tracking which operator moved each item.
                </p>
              </div>

            </div>
          </section>

          <!-- Section 3: Ledger Immutability -->
          <section id="ledger-integrity" class="space-y-8 border-t border-white/5 pt-16 scroll-mt-24">
            <div class="border-l-2 border-indigo-500 pl-6">
              <SectionEyebrow class="mb-2">Manual Section 03</SectionEyebrow>
              <h2 class="text-3xl font-light text-white uppercase tracking-tight">Ledger Immutability</h2>
            </div>
            
            <p class="text-base text-zinc-400 leading-relaxed font-sans">
              Bodega operates a secure, permanent history log. Every single stock movement contains:
            </p>

            <ul class="space-y-3 font-mono text-xs text-zinc-400">
              <li class="flex items-start gap-4">
                <span class="text-indigo-500">[1]</span>
                <div>
                  <strong class="text-white block uppercase">PREVIOUS_RECORD_LINK</strong>
                  Connects the new log entry with the previous transaction, ensuring an unbroken, tamper-proof history trail.
                </div>
              </li>
              <li class="flex items-start gap-4 border-t border-white/5 pt-3">
                <span class="text-indigo-500">[2]</span>
                <div>
                  <strong class="text-white block uppercase">MOVEMENT_DETAILS</strong>
                  Records the warehouse location, the operator's ID, the action type, and the exact count changes.
                </div>
              </li>
              <li class="flex items-start gap-4 border-t border-white/5 pt-3">
                <span class="text-indigo-500">[3]</span>
                <div>
                  <strong class="text-white block uppercase">SECURITY_SIGNATURE</strong>
                  An encrypted signature that verifies the action was authorized by an approved operator.
                </div>
              </li>
            </ul>

            <div class="p-6 border border-indigo-500/20 bg-indigo-500/[0.01] relative">
              <span class="absolute top-0 left-0 w-2 h-2 border-t border-l border-indigo-500/40"></span>
              <p class="text-sm font-sans font-medium text-zinc-300 leading-relaxed">
                If any history record is altered or tampered with, the security link breaks instantly. The system will immediately alert management, flag the discrepancies, and lock affected scanning terminals to prevent incorrect data from spreading.
              </p>
            </div>
          </section>

        </div>
      </div>
    </main>

    <Footer />
  </div>
<script>
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');

  function setActive(id: string) {
    navLinks.forEach((link) => {
      const isActive = link.dataset.navLink === id;
      link.classList.toggle('text-indigo-400', isActive);
      link.classList.toggle('font-bold', isActive);
      link.classList.toggle('border-indigo-500', isActive);
      link.classList.toggle('text-zinc-400', !isActive);
      link.classList.toggle('border-transparent', !isActive);
    });
  }

  // Set the first section active on load
  if (sections.length > 0) setActive(sections[0].id);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          setActive(entry.target.id);
        }
      });
    },
    {
      // Fire when a section enters the top 30% of the viewport
      rootMargin: '-20% 0px -70% 0px',
      threshold: 0,
    }
  );

  sections.forEach((section) => observer.observe(section));
</script>
</Layout>
