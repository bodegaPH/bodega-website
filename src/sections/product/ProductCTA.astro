---
import SectionEyebrow from '../../components/ui/astro/SectionEyebrow.astro';
import PrimaryButton from '../../components/ui/astro/PrimaryButton.astro';
import SecondaryButton from '../../components/ui/astro/SecondaryButton.astro';
---

<section class="relative px-6 py-32 md:py-48 w-full bg-zinc-950 flex items-center justify-center border-t border-white/5">
  
  <div class="max-w-[1600px] w-full mx-auto relative z-10">
    <!-- Massive Tactical Container -->
    <div class="relative border border-white/10 bg-zinc-900/40 flex flex-col items-center text-center p-10 md:p-20 overflow-hidden group">
      <!-- Tactical Corners -->
      <div class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 border-white/40 z-20"></div>
      <div class="absolute top-0 right-0 w-8 h-8 border-t-2 border-r-2 border-white/40 z-20"></div>
      <div class="absolute bottom-0 left-0 w-8 h-8 border-b-2 border-l-2 border-white/40 z-20"></div>
      <div class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 border-white/40 z-20"></div>

      <!-- Background scanning effect -->
      <div class="absolute inset-0 z-0 pointer-events-none opacity-20 transition-opacity duration-1000 group-hover:opacity-40">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern id="product-cta-grid" width="40" height="40" patternUnits="userSpaceOnUse">
              <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#fff" stroke-width="1" stroke-opacity="0.1"></path>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill="url(#product-cta-grid)"></rect>
          <!-- Scanning horizontal line -->
          <line x1="0" y1="0" x2="100%" y2="0" stroke="#6366f1" stroke-width="2" stroke-opacity="0.5">
            <animate attributeName="y1" values="-10;110%;-10" dur="8s" repeatCount="indefinite"></animate>
            <animate attributeName="y2" values="-10;110%;-10" dur="8s" repeatCount="indefinite"></animate>
          </line>
        </svg>
      </div>

      <!-- Content wrapper -->
      <div class="relative z-10 max-w-2xl flex flex-col items-center">
        <SectionEyebrow class="mb-6">SYSTEM_DEPLOYMENT</SectionEyebrow>
        
        <h2 class="text-3xl md:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.1] mb-6 uppercase">
          Ready to run this <br class="hidden sm:inline" /> in your warehouse?
        </h2>
        
        <p class="text-zinc-400 font-light text-sm md:text-base leading-relaxed bg-zinc-950/50 p-4 border border-white/5 mb-10 max-w-lg">
          Initialize your local node, connect your scanner network, and establish an absolute, tamper-proof source of truth in less than a day.
        </p>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full justify-center mb-8">
          <PrimaryButton href="https://bodega-app-one.vercel.app/auth/signup" class="w-full sm:w-auto min-w-[220px] justify-center">
            Start Free Trial
          </PrimaryButton>
          <SecondaryButton href="mailto:demo@bodega.sh?subject=Bodega%20Demo%20Request" class="w-full sm:w-auto min-w-[220px] justify-center">
            Book a Demo
          </SecondaryButton>
        </div>

        <!-- Trust signals -->
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-zinc-500 font-mono text-[11px] tracking-widest uppercase">
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-indigo-500/60 block"></span>
            No credit card
          </span>
          <span class="hidden sm:inline text-zinc-850">•</span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-indigo-500/60 block"></span>
            Works offline
          </span>
          <span class="hidden sm:inline text-zinc-850">•</span>
          <span class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-indigo-500/60 block"></span>
            Setup in under a day
          </span>
        </div>
      </div>

    </div>
  </div>
</section>
