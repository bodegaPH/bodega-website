---
import SectionEyebrow from '../../components/ui/astro/SectionEyebrow.astro';
import OpBadge from '../../components/ui/astro/OpBadge.astro';
---

<section class="px-6 py-32 max-w-[1600px] w-full mx-auto relative z-10 bg-zinc-950 border-b border-white/5">
  <!-- Section Title -->
  <div class="mb-16 md:mb-24 flex flex-col md:flex-row md:items-end justify-between gap-8">
    <div class="border-l border-indigo-500 pl-6 border-solid">
      <SectionEyebrow class="mb-4">
        Platform Core Specifications
      </SectionEyebrow>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-light text-white leading-[1.1] uppercase">
        Engineered<br/>To Zero Latency.
      </h2>
    </div>
    <p class="text-sm text-zinc-400 font-sans max-w-md bg-zinc-900/50 p-5 border border-zinc-800 relative shadow-inner">
      <span class="absolute top-0 left-0 w-1.5 h-1.5 border-t border-l border-zinc-500"></span>
      Every warehouse runs on a fast, dedicated local tracker. We sync directly with scanners and scales to ensure zero data delay and absolute stock accuracy.
    </p>
  </div>

  <!-- Specs Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <!-- Specification 1: Cryptographic Verification Chains -->
    <div class="relative border border-white/5 bg-zinc-950 flex flex-col group overflow-hidden">
      <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/40"></div>
      <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-white/40"></div>
      <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-white/40"></div>
      <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/40"></div>

      <!-- Animated Graphic Area -->
      <div class="relative border-b border-zinc-900 bg-zinc-900/20 flex flex-col justify-center h-[180px]">
        <svg class="w-full h-full object-contain p-6" viewBox="0 0 400 120" fill="none" preserveAspectRatio="xMidYMid meet">
          <!-- Dot grid background -->
          <pattern id="dot-grid-spec1" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="1" height="1" fill="#27272a"></rect>
          </pattern>
          <rect x="0" y="0" width="400" height="120" fill="url(#dot-grid-spec1)"></rect>

          <!-- Cryptographic Block Links -->
          <rect x="50" y="40" width="60" height="40" stroke="#3f3f46" stroke-width="1" fill="#09090b"></rect>
          <rect x="170" y="40" width="60" height="40" stroke="#6366f1" stroke-width="1.5" fill="#09090b"></rect>
          <rect x="290" y="40" width="60" height="40" stroke="#3f3f46" stroke-width="1" fill="#09090b"></rect>

          <!-- Connector arrows -->
          <path d="M 110 60 L 170 60" stroke="#6366f1" stroke-width="1" stroke-dasharray="4 4"></path>
          <path d="M 230 60 L 290 60" stroke="#52525b" stroke-width="1"></path>
          
          <!-- Animated flow pulses -->
          <circle cx="110" cy="60" r="2" fill="#6366f1">
            <animate attributeName="cx" from="110" to="170" dur="2s" repeatCount="indefinite"></animate>
            <animate attributeName="opacity" values="0;1;0" keyTimes="0;0.5;1" dur="2s" repeatCount="indefinite"></animate>
          </circle>

          <!-- Monospace hash text labels -->
          <text x="56" y="55" fill="#52525b" font-size="7" font-family="monospace">BLOCK:091</text>
          <text x="56" y="68" fill="#52525b" font-size="7" font-family="monospace">HASH:a41f</text>

          <text x="176" y="55" fill="#6366f1" font-size="7" font-family="monospace">BLOCK:092</text>
          <text x="176" y="68" fill="#6366f1" font-size="7" font-family="monospace">HASH:71b9</text>

          <text x="296" y="55" fill="#52525b" font-size="7" font-family="monospace">BLOCK:093</text>
          <text x="296" y="68" fill="#52525b" font-size="7" font-family="monospace">HASH:e902</text>
        </svg>
      </div>

      <div class="p-5 flex justify-between items-start flex-col gap-2">
        <span class="text-[10px] font-mono text-indigo-500 tracking-widest uppercase flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-indigo-500"></span>
          OP:HASH_CHAIN
        </span>
        <h3 class="text-lg font-normal text-white tracking-wide leading-none mt-2">Discrepancy Prevention</h3>
      </div>
      
      <div class="px-5 pb-6 pt-1 flex-grow">
        <p class="text-sm font-light text-zinc-400 leading-relaxed font-sans">
          Your digital records and physical stock are locked in sync. If a barcode scan doesn't match your inventory rules, the system flags the error immediately before incorrect counts are saved.
        </p>
      </div>
    </div>

    <!-- Specification 2: Real-time Edge Synchronization -->
    <div class="relative border border-white/5 bg-zinc-950 flex flex-col group overflow-hidden">
      <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/40"></div>
      <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-white/40"></div>
      <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-white/40"></div>
      <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/40"></div>

      <!-- Animated Graphic Area -->
      <div class="relative border-b border-zinc-900 bg-zinc-900/20 flex flex-col justify-center h-[180px]">
        <svg class="w-full h-full object-contain p-6" viewBox="0 0 400 120" fill="none" preserveAspectRatio="xMidYMid meet">
          <pattern id="dot-grid-spec2" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="1" height="1" fill="#27272a"></rect>
          </pattern>
          <rect x="0" y="0" width="400" height="120" fill="url(#dot-grid-spec2)"></rect>

          <!-- Core Pulse -->
          <circle cx="200" cy="60" r="30" stroke="#3f3f46" stroke-width="1"></circle>
          <circle cx="200" cy="60" r="45" stroke="#27272a" stroke-width="1" stroke-dasharray="4 4"></circle>
          
          <!-- Radiating pulse ring -->
          <circle cx="200" cy="60" r="10" stroke="#6366f1" stroke-width="1" opacity="1">
            <animate attributeName="r" from="10" to="50" dur="2s" repeatCount="indefinite"></animate>
            <animate attributeName="opacity" from="1" to="0" dur="2s" repeatCount="indefinite"></animate>
          </circle>

          <!-- Center Node Square -->
          <rect x="195" y="55" width="10" height="10" fill="#6366f1"></rect>

          <!-- Peripheral device points -->
          <circle cx="100" cy="30" r="2.5" fill="#a1a1aa"></circle>
          <circle cx="300" cy="90" r="2.5" fill="#a1a1aa"></circle>
          <circle cx="100" cy="90" r="2.5" fill="#a1a1aa"></circle>
          <circle cx="300" cy="30" r="2.5" fill="#a1a1aa"></circle>

          <!-- Uplink communication lines -->
          <line x1="200" y1="60" x2="100" y2="30" stroke="#52525b" stroke-width="0.5" stroke-dasharray="2 2"></line>
          <line x1="200" y1="60" x2="300" y2="90" stroke="#52525b" stroke-width="0.5" stroke-dasharray="2 2"></line>
          <line x1="200" y1="60" x2="100" y2="90" stroke="#52525b" stroke-width="0.5" stroke-dasharray="2 2"></line>
          <line x1="200" y1="60" x2="300" y2="30" stroke="#52525b" stroke-width="0.5" stroke-dasharray="2 2"></line>
        </svg>
      </div>

      <div class="p-5 flex justify-between items-start flex-col gap-2">
        <span class="text-[10px] font-mono text-indigo-500 tracking-widest uppercase flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-indigo-500"></span>
          OP:HARDWARE_SYNC
        </span>
        <h3 class="text-lg font-normal text-white tracking-wide leading-none mt-2">Real-Time Terminal Sync</h3>
      </div>

      <div class="px-5 pb-6 pt-1 flex-grow">
        <p class="text-sm font-light text-zinc-400 leading-relaxed font-sans">
          Sync status across warehouse handhelds, inventory scales, and conveyor sensors in under 12 milliseconds. Zero latency, zero outdated data.
        </p>
      </div>
    </div>

    <!-- Specification 3: Node Isolation -->
    <div class="relative border border-white/5 bg-zinc-950 flex flex-col group overflow-hidden">
      <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/40"></div>
      <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-white/40"></div>
      <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-white/40"></div>
      <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/40"></div>

      <!-- Animated Graphic Area -->
      <div class="relative border-b border-zinc-900 bg-zinc-900/20 flex flex-col justify-center h-[180px]">
        <svg class="w-full h-full object-contain p-6" viewBox="0 0 400 120" fill="none" preserveAspectRatio="xMidYMid meet">
          <pattern id="dot-grid-spec3" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="1" height="1" fill="#27272a"></rect>
          </pattern>
          <rect x="0" y="0" width="400" height="120" fill="url(#dot-grid-spec3)"></rect>

          <!-- Core node bounds -->
          <rect x="80" y="20" width="100" height="80" stroke="#3f3f46" stroke-width="1" fill="#09090b" stroke-dasharray="2 2"></rect>
          <rect x="220" y="20" width="100" height="80" stroke="#6366f1" stroke-width="1.5" fill="#09090b"></rect>

          <!-- Lock graphics in bounds -->
          <circle cx="130" cy="55" r="10" stroke="#52525b" stroke-width="1"></circle>
          <rect x="124" y="55" width="12" height="10" stroke="#52525b" stroke-width="1"></rect>

          <!-- Active Lock on Isolated Node -->
          <circle cx="270" cy="55" r="10" stroke="#6366f1" stroke-width="1.5"></circle>
          <rect x="264" y="55" width="12" height="10" fill="#6366f1"></rect>

          <text x="96" y="90" fill="#52525b" font-size="8" font-family="monospace">NODE_ALPHA</text>
          <text x="238" y="90" fill="#6366f1" font-size="8" font-family="monospace">NODE_BETA // ISOLATED</text>
        </svg>
      </div>

      <div class="p-5 flex justify-between items-start flex-col gap-2">
        <span class="text-[10px] font-mono text-indigo-500 tracking-widest uppercase flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-indigo-500"></span>
          OP:ISOLATION
        </span>
        <h3 class="text-lg font-normal text-white tracking-wide leading-none mt-2">Always-On Local Processing</h3>
      </div>

      <div class="px-5 pb-6 pt-1 flex-grow">
        <p class="text-sm font-light text-zinc-400 leading-relaxed font-sans">
          Every warehouse facility operates independently. If one location loses connection, operations continue locally and sync back seamlessly once online.
        </p>
      </div>
    </div>

    <!-- Specification 4: Zero Trust Access Matrix -->
    <div class="relative border border-white/5 bg-zinc-950 flex flex-col group overflow-hidden">
      <div class="absolute top-0 left-0 w-2 h-2 border-t border-l border-white/40"></div>
      <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-white/40"></div>
      <div class="absolute bottom-0 left-0 w-2 h-2 border-b border-l border-white/40"></div>
      <div class="absolute bottom-0 right-0 w-2 h-2 border-b border-r border-white/40"></div>

      <!-- Animated Graphic Area -->
      <div class="relative border-b border-zinc-900 bg-zinc-900/20 flex flex-col justify-center h-[180px]">
        <svg class="w-full h-full object-contain p-6" viewBox="0 0 400 120" fill="none" preserveAspectRatio="xMidYMid meet">
          <pattern id="dot-grid-spec4" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
            <rect x="0" y="0" width="1" height="1" fill="#27272a"></rect>
          </pattern>
          <rect x="0" y="0" width="400" height="120" fill="url(#dot-grid-spec4)"></rect>

          <!-- Core visual: Matrix lines -->
          <line x1="80" y1="40" x2="320" y2="40" stroke="#3f3f46" stroke-width="1"></line>
          <line x1="80" y1="60" x2="320" y2="60" stroke="#6366f1" stroke-width="1.5"></line>
          <line x1="80" y1="80" x2="320" y2="80" stroke="#3f3f46" stroke-width="1"></line>

          <circle cx="120" cy="40" r="3" fill="#52525b"></circle>
          <circle cx="200" cy="40" r="3" fill="#52525b"></circle>
          <circle cx="280" cy="40" r="3" fill="#52525b"></circle>

          <rect x="117" y="57" width="6" height="6" fill="#6366f1"></rect>
          <rect x="197" y="57" width="6" height="6" fill="#6366f1"></rect>
          <rect x="277" y="57" width="6" height="6" fill="#09090b" stroke="#6366f1" stroke-width="1"></rect>

          <circle cx="120" cy="80" r="3" fill="#52525b"></circle>
          <circle cx="200" cy="80" r="3" fill="#52525b"></circle>
          <circle cx="280" cy="80" r="3" fill="#52525b"></circle>

          <text x="85" y="32" fill="#52525b" font-size="8" font-family="monospace">READ</text>
          <text x="85" y="52" fill="#6366f1" font-size="8" font-family="monospace">WRITE // SECURE</text>
          <text x="85" y="72" fill="#52525b" font-size="8" font-family="monospace">EXECUTE</text>
        </svg>
      </div>

      <div class="p-5 flex justify-between items-start flex-col gap-2">
        <span class="text-[10px] font-mono text-indigo-500 tracking-widest uppercase flex items-center gap-2">
          <span class="w-1.5 h-1.5 bg-indigo-500"></span>
          OP:RBAC_VERIFY
        </span>
        <h3 class="text-lg font-normal text-white tracking-wide leading-none mt-2">Role-Based Scanning Access</h3>
      </div>

      <div class="px-5 pb-6 pt-1 flex-grow">
        <p class="text-sm font-light text-zinc-400 leading-relaxed font-sans">
          Scan permissions are verified instantly at the device level. Operators can only execute actions they are authorized for, preventing layout errors and accidental stock changes.
        </p>
      </div>
    </div>
  </div>
</section>
